{
  "schema_version": 1,
  "id": "antigravity",
  "name": "Antigravity",
  "version": "1.3.10",
  "protocol_version": 1,
  "runtime": {
    "type": "node",
    "entry": "adapter.mjs",
    "version": ">=20"
  },
  "capabilities": [
    "probe",
    "list_sessions",
    "read_session",
    "project_command_parts"
  ],
  "input_kinds": [
    "live",
    "directory"
  ],
  "card_contract_version": 1,
  "card_kinds": [
    {
      "id": "antigravity.answer",
      "semantic_role": "answer",
      "label": "Answer",
      "default_renderer": "markdown",
      "allowed_renderers": [
        "markdown",
        "plain",
        "json"
      ]
    },
    {
      "id": "antigravity.tool",
      "semantic_role": "tool",
      "label": "Tool",
      "default_renderer": "plain",
      "allowed_renderers": [
        "plain",
        "markdown",
        "json"
      ]
    },
    {
      "id": "antigravity.command",
      "semantic_role": "command",
      "label": "Command",
      "default_renderer": "command",
      "allowed_renderers": [
        "command"
      ]
    },
    {
      "id": "antigravity.code",
      "semantic_role": "code",
      "label": "Code",
      "default_renderer": "code",
      "allowed_renderers": [
        "code"
      ]
    },
    {
      "id": "antigravity.result",
      "semantic_role": "result",
      "label": "Result",
      "default_renderer": "terminal_output",
      "allowed_renderers": [
        "terminal_output",
        "plain",
        "markdown",
        "json"
      ]
    },
    {
      "id": "antigravity.file-change",
      "semantic_role": "file-change",
      "label": "文件更改",
      "default_renderer": "diff",
      "allowed_renderers": [
        "diff"
      ]
    },
    {
      "id": "antigravity.skill-content",
      "semantic_role": "skill",
      "label": "Skill 内容",
      "default_renderer": "markdown",
      "allowed_renderers": [
        "markdown"
      ],
      "icon_hint": "book-open"
    }
  ]
}
