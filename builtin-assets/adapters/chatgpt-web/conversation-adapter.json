{
  "schema_version": 1,
  "id": "chatgpt-web",
  "name": "ChatGPT Web",
  "version": "0.4.5",
  "protocol_version": 1,
  "command": [
    "adapter.js"
  ],
  "capabilities": [
    "probe",
    "list_sessions",
    "read_session",
    "web_records",
    "project_command_parts"
  ],
  "input_kinds": [
    "directory"
  ],
  "card_contract_version": 1,
  "card_kinds": [
    {
      "id": "chatgpt-web.answer",
      "semantic_role": "answer",
      "label": "Answer",
      "default_renderer": "markdown",
      "allowed_renderers": [
        "markdown",
        "plain",
        "json"
      ]
    },
    {
      "id": "chatgpt-web.tool",
      "semantic_role": "tool",
      "label": "Tool",
      "default_renderer": "plain",
      "allowed_renderers": [
        "plain",
        "markdown",
        "json"
      ]
    },
    {
      "id": "chatgpt-web.command",
      "semantic_role": "command",
      "label": "Command",
      "default_renderer": "command",
      "allowed_renderers": [
        "command"
      ]
    },
    {
      "id": "chatgpt-web.code",
      "semantic_role": "code",
      "label": "Code",
      "default_renderer": "code",
      "allowed_renderers": [
        "code"
      ]
    },
    {
      "id": "chatgpt-web.result",
      "semantic_role": "result",
      "label": "Result",
      "default_renderer": "terminal_output",
      "allowed_renderers": [
        "terminal_output",
        "plain",
        "markdown",
        "json"
      ]
    },
    {
      "id": "chatgpt-web.file-change",
      "semantic_role": "file-change",
      "label": "文件更改",
      "default_renderer": "diff",
      "allowed_renderers": [
        "diff"
      ]
    }
  ]
}
