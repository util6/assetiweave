{
  "schema_version": 1,
  "id": "codebuddy",
  "name": "CodeBuddy",
  "version": "1.1.0",
  "protocol_version": 1,
  "runtime": {
    "type": "node",
    "entry": "adapter.mjs",
    "version": ">=20"
  },
  "capabilities": [
    "probe",
    "list_sessions",
    "read_session",
    "project_command_parts",
    "read_usage"
  ],
  "input_kinds": [
    "live",
    "directory",
    "file"
  ],
  "card_contract_version": 1,
  "projection_version": 1,
  "card_kinds": [
    {
      "id": "codebuddy.answer",
      "semantic_role": "answer",
      "label": "Answer",
      "default_renderer": "markdown",
      "allowed_renderers": [
        "markdown",
        "plain",
        "json"
      ]
    },
    {
      "id": "codebuddy.tool",
      "semantic_role": "tool",
      "label": "Tool",
      "default_renderer": "plain",
      "allowed_renderers": [
        "plain",
        "markdown",
        "json"
      ]
    },
    {
      "id": "codebuddy.command",
      "semantic_role": "command",
      "label": "Command",
      "default_renderer": "command",
      "allowed_renderers": [
        "command"
      ]
    },
    {
      "id": "codebuddy.code",
      "semantic_role": "code",
      "label": "Code",
      "default_renderer": "code",
      "allowed_renderers": [
        "code"
      ]
    },
    {
      "id": "codebuddy.result",
      "semantic_role": "result",
      "label": "Result",
      "default_renderer": "terminal_output",
      "allowed_renderers": [
        "terminal_output",
        "plain",
        "markdown",
        "json"
      ]
    },
    {
      "id": "codebuddy.file-change",
      "semantic_role": "file-change",
      "label": "文件更改",
      "default_renderer": "diff",
      "allowed_renderers": [
        "diff"
      ]
    },
    {
      "id": "codebuddy.reasoning",
      "semantic_role": "reasoning",
      "label": "Reasoning",
      "default_renderer": "markdown",
      "allowed_renderers": [
        "markdown",
        "plain"
      ],
      "icon_hint": "brain"
    }
  ]
}
